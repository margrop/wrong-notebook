# 数据库连接地址
# 本地开发通常使用 SQLite，路径相对于 prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# NextAuth 会话加密密钥
# 生产环境必须修改！可以使用 `openssl rand -base64 32` 生成
NEXTAUTH_SECRET="supersecret-dev-secret"

# 配置文件 app-config.json 所在目录（可选，默认为 ./config）
# CONFIG_DIR="./config"

# 应用的基础 URL
# 本地开发通常是 http://localhost:3000
# 生产环境如果使用 Docker 且 IP 不固定，建议注释掉此项并启用 AUTH_TRUST_HOST
# NEXTAUTH_URL="http://localhost:3000"

# 信任 Host 请求头
# 设置为 true 时，NextAuth 会根据请求头自动推断 URL，适合 Docker/PaaS 环境
AUTH_TRUST_HOST=true

# 是否允许新用户注册（默认 false）。网页中「设置 → 用户管理」保存的开关优先
# ALLOW_REGISTRATION=false

# 普通用户每天可发起的 AI 操作次数（默认 0，不限制；管理员不受限制）。网页中「设置 → 用户管理」保存的值优先
# AI_DAILY_LIMIT=0

# 动画语音讲解的朗读方式（默认 browser）：browser 为浏览器本地语音；minimax、qwen 为云端语音，复用下方对应渠道的 API Key。
# 网页中「设置 → AI 设置 → 语音讲解」保存的值优先
# TTS_MODE=browser

# AI 服务提供商配置
# 可选值: "minimax" (默认)、"minimax-code"、"glm"、"deepseek"、"kimi"、"qwen"、"anthropic"、"azure"、"openai"、"gemini"
AI_PROVIDER="minimax"

# 国产大模型官方渠道（OpenAI 兼容接口，BASE_URL 和 MODEL 可选，留空使用官方默认值）
# MiniMax (当 AI_PROVIDER="minimax" 时需要)
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="" # 默认为 https://api.minimax.cn/v1，国际站为 https://api.minimax.io/v1
MINIMAX_MODEL="" # 默认为 MiniMax-M3.1-Flash
# 智谱 GLM (当 AI_PROVIDER="glm" 时需要)
GLM_API_KEY=""
GLM_BASE_URL="" # 默认为 https://open.bigmodel.cn/api/paas/v4，国际站为 https://api.z.ai/api/paas/v4
GLM_MODEL="" # 默认为 glm-5.3-flash
# DeepSeek (当 AI_PROVIDER="deepseek" 时需要)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="" # 默认为 https://api.deepseek.com
DEEPSEEK_MODEL="" # 默认为 deepseek-flash
# Kimi (当 AI_PROVIDER="kimi" 时需要)
KIMI_API_KEY=""
KIMI_BASE_URL="" # 默认为 https://api.moonshot.cn/v1，国际站为 https://api.moonshot.ai/v1
KIMI_MODEL="" # 默认为 kimi-k3
# 千问 Qwen (当 AI_PROVIDER="qwen" 时需要；推荐阿里云百炼 Token Plan，Key 以 sk-sp- 开头)
QWEN_API_KEY=""
QWEN_BASE_URL="" # 默认为 Token Plan 地址 https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1，按量付费的 Key 填 https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL="" # 默认为 qwen3.8-max

# MiniMax Code OAuth (当 AI_PROVIDER="minimax-code" 时使用)：在网页“设置 → AI 设置”中登录账号，无需 API Key
MINIMAX_CODE_MODEL="" # 默认为 MiniMax-M3.1-Flash
MINIMAX_CODE_AUTO_CHECKIN="true" # 每日自动签到领取积分，设为 false 关闭

# Anthropic 配置 (当 AI_PROVIDER="anthropic" 时需要，也可用于兼容 Anthropic Messages API 的服务)
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="" # 可选，不含 /v1，默认为 https://api.anthropic.com
ANTHROPIC_MODEL="claude-sonnet-5-5" # 可选，默认为 claude-sonnet-5-5

# OpenAI 配置 (当 AI_PROVIDER="openai" 时需要)
OPENAI_API_KEY=""
OPENAI_BASE_URL="" # 可选，用于兼容的 API 服务
OPENAI_MODEL="gpt-6.1-sol" # 可选，默认为 gpt-6.1-sol

# Google Gemini 配置 (当 AI_PROVIDER="gemini" 时需要)
GOOGLE_API_KEY=""
GEMINI_BASE_URL="" # 可选，用于自定义 API 地址
GEMINI_MODEL="gemini-2.5-flash" # 可选，默认为 gemini-2.5-flash

# 日志配置
# 日志级别: trace, debug, info, warn, error, fatal
# 开发环境建议使用 debug，生产环境建议使用 info
LOG_LEVEL="debug"

# Database Debugging
# Set to "true" to enable SQL query logging
DEBUG_DB="false"

# Openclaw Agent API 配置
# 用于对接本地部署的 Openclaw agent 进行错题识别
OPENCLAW_API_URL="http://localhost:8080"  # Openclaw agent 服务地址
OPENCLAW_API_KEY=""  # Openclaw API 密钥
OPENCLAW_TIMEOUT=30000  # 请求超时时间（毫秒），默认30秒

# 本系统 API 认证模式配置
# 可选值: "credentials" (用户名密码登录，默认) 或 "apikey" (API Key认证)
OPENCLAW_AUTH_MODE="credentials"

# 本系统 API 密钥（用于 Openclaw agent 调用本系统）
# 仅当 OPENCLAW_AUTH_MODE=apikey 时需要配置
# 生成方式: openssl rand -hex 32
OPENCLAW_INTEGRATION_API_KEY=""
