#!/bin/sh
# 群晖套件服务控制。脚本以套件用户运行，不能调用 docker：
# 容器由 conf/resource 的 docker-project 资源随套件启停，这里只按服务端口报告状态。
set -eu

WN_HOST_PORT=39300

# 端口有 HTTP 响应即视为运行中（数据库迁移期间健康检查尚未就绪，也算已启动）
responding() {
    curl -s -o /dev/null --max-time 5 "http://127.0.0.1:${WN_HOST_PORT}/api/health" 2>/dev/null
}

wait_responding() {
    i=0
    while [ "${i}" -lt 90 ]; do
        if responding; then
            return 0
        fi
        i=$((i + 1))
        sleep 2
    done
    return 1
}

case "${1:-status}" in
    start)
        if ! wait_responding; then
            echo "错题本容器未在预期时间内响应，请在 Container Manager 的「项目」中查看 wrong-notebook 的日志。"
            exit 1
        fi
        ;;
    stop | prestart | prestop) ;;
    status)
        if responding; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|status}" >&2
        exit 1
        ;;
esac
exit 0
