#!/bin/sh
# 群晖套件：安装前检查 Docker CLI；套件本身只管理容器，不内置 Node.js。
set -eu

find_docker() {
    if command -v docker >/dev/null 2>&1; then
        command -v docker
        return 0
    fi
    for candidate in /usr/local/bin/docker /usr/bin/docker /var/packages/ContainerManager/target/usr/bin/docker; do
        if [ -x "${candidate}" ]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done
    return 1
}

if ! find_docker >/dev/null 2>&1; then
    echo "未找到 docker CLI。请先在套件中心安装 Container Manager，再安装错题本。" >&2
    exit 1
fi
exit 0
