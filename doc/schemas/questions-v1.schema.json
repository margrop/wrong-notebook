{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrong-notebook.local/schemas/questions-v1.schema.json",
  "title": "Wrong Notebook Question Exchange Format v1",
  "type": "object",
  "required": ["format", "version", "questions"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "wrong-notebook-questions"
    },
    "version": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "description": "ISO 8601 export timestamp"
    },
    "generator": {
      "type": "string",
      "maxLength": 200,
      "description": "Generator identifier (app name or version)"
    },
    "questions": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "description": "Question stem (required)"
          },
          "material": {
            "type": "string",
            "maxLength": 20000,
            "description": "Shared material / passage"
          },
          "section": {
            "type": "string",
            "maxLength": 500,
            "description": "Section / big-question title"
          },
          "label": {
            "type": "string",
            "maxLength": 20,
            "description": "Original question number or label"
          },
          "answer": {
            "type": "string",
            "maxLength": 20000,
            "description": "Answer"
          },
          "analysis": {
            "type": "string",
            "maxLength": 50000,
            "description": "Solution analysis"
          },
          "knowledgePoints": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Knowledge point tags"
          },
          "difficultyStars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Difficulty in stars (1-5)"
          },
          "wrongAnswer": {
            "type": "string",
            "maxLength": 20000,
            "description": "Student's wrong answer"
          },
          "subject": {
            "type": "string",
            "maxLength": 100,
            "description": "Subject name or key (e.g. \"数学\" or \"math\")"
          },
          "gradeSemester": {
            "type": "string",
            "maxLength": 100,
            "description": "Grade and semester"
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "description": "Source (e.g. \"2025 期中\")"
          },
          "questionType": {
            "type": "string",
            "maxLength": 100,
            "description": "Question type (kept as-is)"
          },
          "figureSvg": {
            "type": "string",
            "maxLength": 100000,
            "description": "Figure SVG markup"
          },
          "images": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": ["dataUrl"],
              "additionalProperties": false,
              "properties": {
                "dataUrl": {
                  "type": "string",
                  "pattern": "^data:image/(png|jpeg|webp);base64,",
                  "maxLength": 5242880,
                  "description": "Base64 data URL, only PNG/JPEG/WebP, max ~5MB characters"
                },
                "alt": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Accessibility text"
                }
              }
            },
            "description": "Embedded images"
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true,
            "description": "Third-party extension fields"
          }
        }
      }
    }
  }
}
